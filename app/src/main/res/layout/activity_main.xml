<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".Activity.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_marginBottom="?attr/bottomSafeSize" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/bottomSafeSize"
        android:layout_gravity="end"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_th"
            android:layout_gravity="top" />

        <View
            android:layout_height="@dimen/height_th"
            android:layout_width="match_parent"
            android:layout_gravity="top"
            android:background="@drawable/bg_btm_handler">
        </View>

        <!-- bottom -->

        <ImageButton
            android:id="@+id/swc_list"
            android:src="@drawable/ic_list"
            app:tint="?attr/ic_fg"
            android:scaleType="fitCenter"
            android:background="#0000"
            android:padding="@dimen/margin_bo"
            android:layout_width="@dimen/btm_icon"
            android:layout_height="@dimen/btm_icon"
            android:layout_gravity="start"
            android:layout_marginStart="@dimen/width_mid"
            android:layout_marginTop="@dimen/height_th" />
        <ImageButton
            android:id="@+id/swc_main"
            android:src="@drawable/ic_home"
            app:tint="?attr/ic_fg"
            android:scaleType="fitCenter"
            android:background="#0000"
            android:padding="@dimen/margin_bo"
            android:layout_width="@dimen/btm_icon"
            android:layout_height="@dimen/btm_icon"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/height_th" />
        <ImageButton
            android:id="@+id/swc_settings"
            android:src="@drawable/ic_config"
            app:tint="?attr/ic_fg"
            android:scaleType="fitCenter"
            android:background="#0000"
            android:padding="@dimen/margin_bo"
            android:layout_width="@dimen/btm_icon"
            android:layout_height="@dimen/btm_icon"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/width_mid"
            android:layout_marginTop="@dimen/height_th" />

    </FrameLayout>

    <!-- Floating Zone -->

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="?attr/bottomSafeSize"
        app:srcCompat="@android:drawable/ic_dialog_email" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>