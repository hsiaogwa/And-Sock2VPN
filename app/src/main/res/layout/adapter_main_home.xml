<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/margin_n">

    <ImageView
        android:id="@+id/home_show_ic"
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="@dimen/margin_bo"
        android:background="#0000"
        android:src="@drawable/ic_launcher_foreground"
    />

    <TextView
        android:id="@+id/home_show_ti"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/home_show_ic"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textSize="@dimen/height_th"
        android:text="Socks5 to VPN"
    />

    <View
        android:id="@+id/home_show_br"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_gray"
        android:layout_marginLeft="@dimen/margin_bo"
        android:layout_marginRight="@dimen/margin_bo"
        app:layout_constraintTop_toBottomOf="@id/home_show_ti"
        android:layout_marginTop="@dimen/margin_bo"
    />

    <TextView
        android:id="@+id/home_sename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/home_show_br"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/margin_n"
        android:text="testx"
        android:textColor="?attr/ft_fg_ll"
        android:textSize="@dimen/font_size_tii"
        android:textStyle="normal"
        android:layout_marginStart="@dimen/margin_n"
    />
    <TextView
        android:id="@+id/home_seip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/home_sename"
        app:layout_constraintStart_toStartOf="@id/home_sename"
        android:text="testx"
        android:textSize="@dimen/font_size"
        android:textStyle="italic"
        android:textColor="?attr/ft_fg_ll"
    />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/home_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/home_sename"
        app:layout_constraintBottom_toBottomOf="@id/home_seip"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginEnd="@dimen/margin_n"
    />

    <View
        android:id="@+id/home_const_br0"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bg_gray"
        android:layout_marginLeft="@dimen/margin_bo"
        android:layout_marginRight="@dimen/margin_bo"
        app:layout_constraintTop_toBottomOf="@id/home_seip"
        android:layout_marginTop="@dimen/margin_bo"
    />

    <ImageView
        android:id="@+id/home_const_usage_icon"
        android:layout_width="@dimen/font_size"
        android:layout_height="@dimen/font_size"
        app:layout_constraintTop_toBottomOf="@id/home_const_br0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="@dimen/margin_bo"
        app:tint="?attr/ic_fg_ll"
        android:src="@drawable/ic_upndown"
    />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintRight_toLeftOf="@id/home_const_usage_icon"
        app:layout_constraintBaseline_toBottomOf="@id/home_const_usage_icon"
        android:text="testx"
        android:textSize="@dimen/font_size"
        android:layout_marginRight="@dimen/margin_th"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toRightOf="@id/home_const_usage_icon"
        app:layout_constraintBaseline_toBottomOf="@id/home_const_usage_icon"
        android:text="testx"
        android:textSize="@dimen/font_size"
        android:layout_marginLeft="@dimen/margin_th"
        />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/home_const_gl_v50"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"
    />

    <TextView
        android:id="@+id/home_usage_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/home_const_usage_icon"
        android:layout_marginTop="@dimen/margin_n"
        app:layout_constraintRight_toLeftOf="@id/home_const_gl_v50"
        android:layout_marginEnd="@dimen/margin_n"
        android:textSize="@dimen/font_size_ti"
        android:textColor="?attr/ft_fg"
        android:textStyle="bold"
        android:text="testx MB"
    />
    <TextView
        android:id="@+id/home_usage_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/home_const_usage_icon"
        android:layout_marginTop="@dimen/margin_n"
        app:layout_constraintLeft_toRightOf="@id/home_const_gl_v50"
        android:layout_marginStart="@dimen/margin_n"
        android:textSize="@dimen/font_size_ti"
        android:textColor="?attr/ft_fg"
        android:textStyle="bold"
        android:text="testx MB"
    />

    <ImageView
        android:id="@+id/home_const_nettest_ic"
        android:layout_width="@dimen/height_bo"
        android:layout_height="@dimen/height_bo"
        app:layout_constraintStart_toStartOf="@id/home_sename"
        app:layout_constraintTop_toBottomOf="@id/home_usage_up"
        android:layout_marginTop="@dimen/margin_bo"
        android:src="@drawable/ic_speed"
        app:tint="?attr/ic_fg"
    />
    <TextView
        android:id="@+id/home_const_nettest_ti"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/home_const_nettest_ic"
        app:layout_constraintBottom_toBottomOf="@id/home_const_nettest_ic"
        app:layout_constraintStart_toEndOf="@id/home_const_nettest_ic"
        android:layout_marginStart="@dimen/margin_bo"
        android:text="testx"
        android:textSize="@dimen/font_size_t"
        android:textColor="?attr/ft_fg"
    />
    <TextView
        android:id="@+id/home_const_nettest_mo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/home_const_nettest_ti"
        app:layout_constraintBottom_toBottomOf="@id/home_const_nettest_ti"
        app:layout_constraintEnd_toEndOf="@id/home_switch"
        android:layout_marginEnd="@dimen/margin_n"
        android:text="\>"
        android:textSize="@dimen/font_size_t"
    />
    <View
        android:id="@+id/home_hitbox_nettest"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_bo"
        app:layout_constraintTop_toTopOf="@id/home_const_nettest_ic"
        app:layout_constraintBottom_toBottomOf="@id/home_const_nettest_ic"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@null"
    />

    <ImageView
        android:id="@+id/home_const_timer_ic"
        android:layout_width="@dimen/height_bo"
        android:layout_height="@dimen/height_bo"
        app:layout_constraintStart_toStartOf="@id/home_sename"
        app:layout_constraintTop_toBottomOf="@id/home_const_nettest_ic"
        android:layout_marginTop="@dimen/margin_bo"
        android:src="@drawable/ic_clock"
        app:tint="?attr/ic_fg"
    />
    <TextView
        android:id="@+id/home_const_timer_ti"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/home_const_timer_ic"
        app:layout_constraintBottom_toBottomOf="@id/home_const_timer_ic"
        app:layout_constraintStart_toEndOf="@id/home_const_timer_ic"
        android:layout_marginStart="@dimen/margin_bo"
        android:text="testx"
        android:textSize="@dimen/font_size_t"
        android:textColor="?attr/ft_fg"
    />
    <TextView
        android:id="@+id/home_const_timer_mo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/home_const_timer_ti"
        app:layout_constraintBottom_toBottomOf="@id/home_const_timer_ti"
        app:layout_constraintEnd_toEndOf="@id/home_switch"
        android:layout_marginEnd="@dimen/margin_n"
        android:text="\>"
        android:textSize="@dimen/font_size_t"
    />
    <View
        android:id="@+id/home_hitbox_timer"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_bo"
        app:layout_constraintTop_toTopOf="@id/home_const_timer_ic"
        app:layout_constraintBottom_toBottomOf="@id/home_const_timer_ic"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:background="@null"
    />



</androidx.constraintlayout.widget.ConstraintLayout>